# Copy to `.env` and adjust. Restart Metro after changes (`npm start`).

# --- Order sync (POST JSON batch). Leave empty to disable background upload. ---
# iOS Simulator: http://localhost:4899/orders/sync
# Android Emulator: http://10.0.2.2:4899/orders/sync
ORDERS_SYNC_URL=http://10.0.2.2:4899/orders/sync
# Optional; if empty, sync can still use GRAPHQL_AUTHORIZATION below
ORDERS_SYNC_AUTHORIZATION=

# --- Food Service GraphQL ---
GRAPHQL_API_BASE=http://localhost:3399/graphql
GRAPHQL_AUTHORIZATION=

# --- Optional REST bases (empty = use in-app fallbacks / demo data) ---
TABLES_API_BASE=
CUSTOMERS_API_BASE=
ASSETS_BASE_URL=
MASTER_DATA_COMPANY_ID=
